# Non-secret host configuration. Replace identifiers/URLs before enabling the service.
NODE_ENV=production
CLIENT_ID=
TENANT_ID=
CLIENT_SECRET_FILE=/etc/teams-bot/secrets/client-secret
BOT_HOST=127.0.0.1
PORT=3978
SHUTDOWN_TIMEOUT_MS=30000
AI_SETTINGS_DIR=/var/lib/teams-bot
AI_SETTINGS_ENCRYPTION_KEY_FILE=/etc/teams-bot/secrets/settings-key
# true makes startup/readiness fail if AI is disabled. Set false only for an explicitly labelled echo smoke test.
AI_REQUIRE_ENABLED=true
AI_ENABLED=false
# Option A: save a complete encrypted profile through the private admin UI.
# Option B: configure AI_PROVIDER, AI_BASE_URL, AI_MODEL and AI_API_KEY_FILE below.
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_MODEL=
# AI_API_KEY_FILE=/etc/teams-bot/secrets/ai-api-key

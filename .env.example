# Sao chép thành .env. Không đưa client secret vào chat/Git/gói Teams.
CLIENT_ID=
CLIENT_SECRET=
# Có thể dùng CLIENT_SECRET_FILE=/absolute/path thay cho CLIENT_SECRET, không đặt cả hai.
TENANT_ID=
TEAMS_APP_ID=
BOT_ENDPOINT=
PORT=3978
SHUTDOWN_TIMEOUT_MS=30000
# BOT_HOST=0.0.0.0 chỉ khi chạy container; mặc định 127.0.0.1.
LOG_LEVEL=error

# AI độc lập với Teams: chỉ cần nhóm AI bên dưới để thử bằng npm run preview.
# Cách đơn giản: mở http://127.0.0.1:3980/settings, nhập cấu hình rồi lưu.
# Cấu hình lưu trên giao diện ưu tiên toàn bộ so với nhóm AI_* bên dưới.
# Thư mục bền vững dùng CHUNG cho Teams và preview; mặc định teams-bot/.state.
# AI_SETTINGS_DIR=/absolute/path/to/private/teams-bot-state
# Host: cung cấp khóa 32 byte dạng 64 ký tự hex qua secret manager.
# Development: bỏ trống sẽ tự tạo .state/ai-settings.key (0600) khi lưu lần đầu.
# Production: NODE_ENV=production bắt buộc thư mục state rõ ràng và khóa cấp riêng.
# File secret POSIX phải không cấp quyền group/other; khóa không nằm trong thư mục state.
# Không thay khóa khi còn dữ liệu mã hóa; backup phải giữ đúng cặp file/khóa.
# AI_SETTINGS_ENCRYPTION_KEY=
# AI_SETTINGS_ENCRYPTION_KEY_FILE=/absolute/path/to/settings-key
# AI_API_KEY_FILE=/absolute/path/to/ai-key thay cho AI_API_KEY.
# AI_REQUIRE_ENABLED=true khi nghiệm thu AI; readiness chỉ kiểm tra cấu hình, không gọi AI.
# Chọn chuẩn API, model và key của cùng nhà cung cấp; không tự đoán nhà cung cấp từ key.
AI_ENABLED=false
# openai (Responses), openai-compatible (Chat Completions), gemini, anthropic
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_API_KEY=
# Bắt buộc cho openai-compatible. Là URL gốc API, gồm /v1 nếu nhà cung cấp yêu cầu.
# Không thêm /chat/completions, /responses hoặc /messages vào URL gốc.
# Có thể bỏ trống khi dùng openai, gemini hoặc anthropic trực tiếp.
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=4000
# Hạn mức trong RAM, theo từng tiến trình; khởi động lại sẽ đặt lại.
AI_DAILY_REQUEST_LIMIT=100
AI_USER_REQUESTS_PER_MINUTE=5
AI_MAX_CONCURRENT=3
# Riêng Chat Completions: một số model/gateway yêu cầu max_completion_tokens.
AI_CHAT_TOKEN_PARAMETER=max_tokens
# AI_SYSTEM_PROMPT="Hướng dẫn riêng cho trợ lý"
# Riêng Anthropic: dùng workspace ID nếu API key của bạn yêu cầu chọn workspace.
# AI_ANTHROPIC_WORKSPACE_ID=
# AI_ANTHROPIC_VERSION=2026-10-21
